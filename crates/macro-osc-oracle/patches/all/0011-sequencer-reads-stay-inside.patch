 const float kIcdfTableSize = 128.0f;
 
+// transit oracle: Interpolate(table + offset, index, size) with both reads
+// kept inside the inverse-cdf table (three sub-tables of 129 entries, 387 in
+// all). A component of a random vector is a 32-bit word divided by 2^32, so it
+// rounds to exactly 1.0 for the top 128 words; a pulse width drawn from such a
+// component reads the upper sub-table at (1.0 - 0.95) * 20 * 128, entry 386
+// plus a sliver, so entry 387, past the table, is read at a nonzero fraction.
+// The index is clamped to the table, so a read at the end returns the end's
+// value; inside, this is Interpolate() exactly. The port does the same.
+inline float TransitInterpolateIcdf(
+    const float* table, int32_t offset, float index, float size) {
+  const int32_t last = 3 * (static_cast<int32_t>(kIcdfTableSize) + 1) - 1;
+  index *= size;
+  MAKE_INTEGRAL_FRACTIONAL(index)
+  int32_t i = offset + index_integral;
+  int32_t j = i + 1;
+  i = i < 0 ? 0 : (i > last ? last : i);
+  j = j < 0 ? 0 : (j > last ? last : j);
+  float a = table[i];
+  float b = table[j];
+  return a + (b - a) * index_fractional;
+}
+
