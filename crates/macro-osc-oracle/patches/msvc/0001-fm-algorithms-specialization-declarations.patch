MSVC only. MSVC (C2737) reads the four declarations of explicit specializations of static data
members as definitions without an initializer, so they are removed. This makes MSVC's copy formally
ill-formed, no diagnostic required (a specialization must be declared before a use that could
instantiate it), but it is safe: the class template has no primary definition of opcodes_ or
renderers_, so nothing is implicitly instantiated and every use links to the definitions in
plaits/dsp/fm/algorithms.cc. Data and arithmetic are unchanged.

--- plaits/dsp/fm/algorithms.h
+++ plaits/dsp/fm/algorithms.h
@@ -195,17 +195,9 @@ class Algorithms {
   DISALLOW_COPY_AND_ASSIGN(Algorithms);
 };
 
-/* static */
-template<> const uint8_t Algorithms<4>::opcodes_[][4];  // From DX100
-
-/* static */
-template<> const Algorithms<4>::RendererSpecs Algorithms<4>::renderers_[];
-
-/* static */
-template<> const uint8_t Algorithms<6>::opcodes_[][6];  // From DX7
-
-/* static */
-template<> const Algorithms<6>::RendererSpecs Algorithms<6>::renderers_[];
+// MSVC (C2737) reads a declaration of an explicit specialization of a static data member as a
+// definition without an initializer. The four declarations are removed for MSVC only; the
+// specializations themselves are defined in algorithms.cc.
 
 }  // namespace fm
 
