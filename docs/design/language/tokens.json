{
  "name": "transit-device-ui",
  "version": "0.1.0",
  "color": {
    "bg.window": "#131518",
    "bg.titlebar": "#16181B",
    "surface.panel": "#1A1D21",
    "surface.raised": "#22262B",
    "surface.inset": "#0D0F11",
    "surface.selected": "#2A2F35",
    "knob.cap": "#262A30",
    "knob.capActive": "#2E333A",
    "line": "#2B3036",
    "line.inset": "#23272C",
    "line.strong": "#383E46",
    "grid": "#1C1F23",
    "text": "#E7E9EC",
    "text.muted": "#A7ADB6",
    "text.faint": "#8C939D",
    "ink.ghost": "#4A5260",
    "ink.arrow": "#585F69",
    "signal": "#4C9EFF",
    "mod": "#F0A73A",
    "meter.ok": "#5FCB8E",
    "meter.hot": "#FF6B5B"
  },
  "alpha": {
    "curveFill": 0.12,
    "scopeFill": 0.08,
    "modBand": 0.1,
    "disabledSection": 0.4
  },
  "font": {
    "sans": "IBM Plex Sans",
    "mono": "IBM Plex Mono"
  },
  "type": {
    "title.brand": {
      "font": "sans",
      "weight": 600,
      "size": 15
    },
    "title.device": {
      "font": "sans",
      "weight": 500,
      "size": 14
    },
    "title.sectionBar": {
      "font": "sans",
      "weight": 600,
      "size": 14
    },
    "label.section": {
      "font": "sans",
      "weight": 600,
      "size": 11,
      "uppercase": true,
      "tracking": 0.08,
      "color": "text.muted"
    },
    "label.control": {
      "font": "sans",
      "weight": 400,
      "size": 12,
      "color": "text.muted"
    },
    "label.hero": {
      "font": "sans",
      "weight": 500,
      "size": 13,
      "color": "text"
    },
    "value": {
      "font": "mono",
      "weight": 500,
      "size": 11,
      "color": "text"
    },
    "readout.display": {
      "font": "mono",
      "weight": 400,
      "size": 11,
      "color": "text.faint"
    },
    "tag": {
      "font": "mono",
      "weight": 500,
      "size": 10,
      "tracking": 0.06
    }
  },
  "space": [
    4,
    8,
    12,
    16,
    24,
    32
  ],
  "layout": {
    "windowPadding": 16,
    "panelGap": 12,
    "panelPadding": [
      14,
      16
    ],
    "gridColumns": 12,
    "titleBarHeight": 52,
    "routingRowHeight": 40,
    "controlHeight": [
      26,
      32
    ],
    "segmentHeight": [
      22,
      24
    ]
  },
  "radius": {
    "panel": 8,
    "display": 6,
    "control": 5,
    "segment": 4,
    "chip": 13,
    "switch": 10
  },
  "knob": {
    "sizes": {
      "L": 72,
      "M": 44,
      "S": 38
    },
    "sweepDegrees": 270,
    "startDegrees": -135,
    "box": 100,
    "track": {
      "radius": 40,
      "stroke": 6,
      "color": "line"
    },
    "value": {
      "radius": 40,
      "stroke": 6,
      "color": "signal"
    },
    "modRing": {
      "radius": 47,
      "stroke": 3.5,
      "color": "mod"
    },
    "cap": {
      "radius": 28,
      "fill": "knob.cap",
      "rim": "line.strong",
      "rimStroke": 1.5
    },
    "pointer": {
      "from": 9,
      "to": 24,
      "stroke": 4,
      "color": "text"
    },
    "disabled": {
      "value": "ink.ghost",
      "pointer": "ink.arrow"
    }
  },
  "switch": {
    "width": 34,
    "height": 20,
    "knob": 14,
    "onTrack": "signal",
    "offTrack": "line.strong",
    "onKnob": "#FFFFFF",
    "offKnob": "text.muted"
  },
  "fader": {
    "taper": [
      [
        6,
        0
      ],
      [
        0,
        0.14
      ],
      [
        -6,
        0.28
      ],
      [
        -12,
        0.42
      ],
      [
        -24,
        0.6
      ],
      [
        -36,
        0.74
      ],
      [
        -48,
        0.86
      ],
      [
        -60,
        0.94
      ],
      [
        null,
        1
      ]
    ],
    "taperNote": "fraction of travel from the top; null = -inf; linear between marks; -60..-90 dB compresses into the last 6%",
    "scaleLabels": [
      6,
      0,
      -6,
      -12,
      -24,
      -36,
      -48,
      null
    ],
    "inset": 10,
    "track": {
      "width": 4,
      "radius": 2,
      "color": "line"
    },
    "fill": {
      "color": "signal",
      "mutedColor": "ink.ghost"
    },
    "cap": {
      "width": 32,
      "height": 16,
      "radius": 3,
      "fill": "#2E333A",
      "rim": "ink.arrow",
      "centerLine": "text",
      "centerLineWidth": 2
    },
    "capCompact": {
      "width": 28,
      "height": 14
    },
    "capHorizontal": {
      "width": 12,
      "height": 18
    },
    "variants": {
      "channel": {
        "width": 116
      },
      "compact": {
        "width": 40
      },
      "horizontal": {
        "height": 24
      }
    },
    "meter": {
      "barWidth": 10,
      "barWidthMain": 14,
      "gap": 3,
      "well": "surface.inset",
      "wellLine": "line.inset",
      "peak": "meter.ok",
      "peakAlpha": 0.35,
      "rms": "meter.ok",
      "hold": "text",
      "holdHeight": 2,
      "clip": "meter.hot",
      "clipCell": 4
    }
  },
  "toggle": {
    "height": 24,
    "radius": 4,
    "font": {
      "font": "sans",
      "weight": 600,
      "size": 11
    },
    "off": {
      "fill": "surface.raised",
      "text": "text.muted",
      "border": "line"
    },
    "on": {
      "mute": {
        "fill": "text",
        "text": "bg.window",
        "border": "text"
      },
      "solo": {
        "fill": "signal",
        "text": "surface.inset",
        "border": "signal"
      },
      "arm": {
        "fill": "meter.hot",
        "text": "bg.window",
        "border": "meter.hot"
      },
      "monitor": {
        "fill": "#1E2A38",
        "text": "signal",
        "border": "signal"
      },
      "option": {
        "fill": "#1E2A38",
        "text": "signal",
        "border": "signal"
      }
    },
    "unavailable": {
      "fill": "#1E2125",
      "text": "ink.arrow",
      "border": "line"
    }
  },
  "pad": {
    "sizes": {
      "grid": 56,
      "focus": 80
    },
    "gap": 4,
    "radius": 6,
    "fill": "surface.raised",
    "border": "line",
    "order": "bottom-left is pad 1 (MPC order)",
    "hit": {
      "color": "signal",
      "alpha": 0.26,
      "edge": 2,
      "heightFrom": "velocity",
      "decayMs": 250
    },
    "selected": {
      "border": "signal",
      "width": 2
    },
    "muted": {
      "opacity": 0.4
    },
    "tag": {
      "height": 3
    },
    "empty": {
      "border": "line.strong",
      "style": "dashed",
      "fill": "transparent",
      "label": "+ Drop"
    }
  },
  "channelStrip": {
    "width": 132,
    "widthMain": 160,
    "gap": 4,
    "colorBar": 3,
    "insertsHeight": 112,
    "sendsHeight": 86,
    "panKnob": 36,
    "selectedBorder": "signal",
    "insertSlot": {
      "height": 22,
      "fill": "surface.raised",
      "border": "line",
      "radius": 4,
      "indicator": "power",
      "indicatorSize": 12,
      "indicatorStroke": 1.5,
      "on": {
        "glyph": "signal",
        "name": "text"
      },
      "bypassed": {
        "glyph": "text.faint",
        "name": "text.muted"
      }
    }
  }
}
