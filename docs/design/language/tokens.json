{
  "name": "transit-device-ui",
  "version": "0.3.0",
  "color": {
    "bg.window": "#131518",
    "bg.titlebar": "#16181B",
    "surface.panel": "#1A1D21",
    "surface.raised": "#22262B",
    "surface.inset": "#0D0F11",
    "surface.selected": "#2A2F35",
    "knob.cap": "#262A30",
    "knob.capActive": "#2E333A",
    "line": "#2B3036",
    "line.inset": "#23272C",
    "line.strong": "#383E46",
    "grid": "#1C1F23",
    "text": "#E7E9EC",
    "text.muted": "#A7ADB6",
    "text.faint": "#8C939D",
    "ink.ghost": "#4A5260",
    "ink.arrow": "#585F69",
    "signal": "#4C9EFF",
    "mod": "#F0A73A",
    "meter.ok": "#5FCB8E",
    "meter.hot": "#FF6B5B"
  },
  "arrangement": {
    "lane": "#171A1D",
    "lane.alt": "#1A1E22",
    "ruler": "#23282D",
    "header": "#23262C",
    "header.selected": "#333840",
    "grid.bar": "#323537",
    "grid.beat": "#242729",
    "grid.sub": "#1C1F21",
    "loop": "#D05DAD",
    "cursor": "#E1E1E3",
    "selection.outline": "#EDEDF0",
    "ink.dark": "#131518",
    "ink.light": "#F6F6F8",
    "record": "#FF6B5B",
    "mute": "#E7E9EC",
    "solo": "#4C9EFF",
    "monitor": "#5FCB8E",
    "focus.ring": "#4C9EFF",
    "button.hover": "#2E333A",
    "overlay": "#00000046"
  },
  "colorLight": {
    "bg.window": "#F9FAFA",
    "bg.titlebar": "#F6F6F8",
    "surface.panel": "#EFF1F3",
    "surface.raised": "#E3E5E9",
    "surface.inset": "#FFFFFF",
    "surface.selected": "#D5D9DE",
    "knob.cap": "#DCE0E4",
    "knob.capActive": "#CED3D9",
    "line": "#D4D7DD",
    "line.inset": "#E1E4E8",
    "line.strong": "#BDC3CB",
    "grid": "#EDEEF1",
    "text": "#202329",
    "text.muted": "#484D56",
    "text.faint": "#5B616B",
    "ink.ghost": "#9EA6B5",
    "ink.arrow": "#8F96A1",
    "signal": "#0055BB",
    "mod": "#633E08",
    "meter.ok": "#1A4F31",
    "meter.hot": "#B51200",
    "lane": "#F3F4F6",
    "lane.alt": "#EEF0F2",
    "ruler": "#E0E3E7",
    "header": "#E2E5E9",
    "header.selected": "#C6CBD2",
    "grid.bar": "#CFCFD1",
    "grid.beat": "#E3E4E5",
    "grid.sub": "#EEEEF0",
    "loop": "#B73590",
    "cursor": "#28282B",
    "selection.outline": "#1F1F26",
    "ink.dark": "#131518",
    "ink.light": "#F6F6F8",
    "record": "#B51200",
    "mute": "#202329",
    "solo": "#0055BB",
    "monitor": "#1A4F31",
    "focus.ring": "#0055BB",
    "button.hover": "#CED3D9",
    "overlay": "#0000001C",
    "toggle.on.option.fill": "#D9E1EB",
    "toggle.unavailable.fill": "#EAECEF",
    "switch.onKnob": "#FFFFFF",
    "chrome.defaultButton.hover": "#1F69C3",
    "chrome.defaultButton.pressed": "#004BA4"
  },
  "colorLightRule": "grounds (bg, surface, knob, line, grid, lane, ruler, header) mirror the dark set: each keeps its contrast ratio to bg.window in the opposite direction, surface.inset white, the graphite hue kept; grid.bar, grid.beat and grid.sub are the lane tinted toward black (toward white in dark) at the ratio that mirrors theirs; inks (text, ink, signal, mod, meter, loop, cursor, selection) keep their hue and at least their dark contrast ratio against bg.window; aliases follow their token",
  "alpha": {
    "curveFill": 0.12,
    "scopeFill": 0.08,
    "modBand": 0.1,
    "disabledSection": 0.4,
    "loopBraceOff": 0.3,
    "loopBraceOffEdge": 0.55,
    "loopRulerTint": 0.2,
    "loopEdge": 0.75,
    "loopScaleRow": 0.12
  },
  "font": {
    "sans": "IBM Plex Sans",
    "mono": "IBM Plex Mono"
  },
  "type": {
    "title.brand": { "font": "sans", "weight": 600, "size": 15 },
    "title.device": { "font": "sans", "weight": 500, "size": 14 },
    "title.sectionBar": { "font": "sans", "weight": 600, "size": 14 },
    "label.section": { "font": "sans", "weight": 600, "size": 11, "uppercase": true, "tracking": 0.08, "color": "text.muted" },
    "label.control": { "font": "sans", "weight": 400, "size": 12, "color": "text.muted" },
    "label.hero": { "font": "sans", "weight": 500, "size": 13, "color": "text" },
    "value": { "font": "mono", "weight": 500, "size": 11, "color": "text" },
    "readout.display": { "font": "mono", "weight": 400, "size": 11, "color": "text.faint" },
    "tag": { "font": "mono", "weight": 500, "size": 10, "tracking": 0.06 }
  },
  "space": [4, 8, 12, 16, 24, 32],
  "layout": {
    "windowPadding": 16,
    "panelGap": 12,
    "panelPadding": [14, 16],
    "gridColumns": 12,
    "titleBarHeight": 52,
    "routingRowHeight": 40,
    "controlHeight": [26, 32],
    "segmentHeight": [22, 24]
  },
  "radius": {
    "panel": 8,
    "display": 6,
    "control": 5,
    "segment": 4,
    "chip": 13,
    "switch": 10
  },
  "knob": {
    "sizes": { "L": 72, "M": 44, "S": 38 },
    "sweepDegrees": 270,
    "startDegrees": -135,
    "box": 100,
    "track": { "radius": 40, "stroke": 6, "color": "line" },
    "value": { "radius": 40, "stroke": 6, "color": "signal" },
    "modRing": { "radius": 47, "stroke": 3.5, "color": "mod" },
    "cap": { "radius": 28, "fill": "knob.cap", "rim": "line.strong", "rimStroke": 1.5 },
    "pointer": { "from": 9, "to": 24, "stroke": 4, "color": "text" },
    "disabled": { "value": "ink.ghost", "pointer": "ink.arrow" }
  },
  "switch": { "width": 34, "height": 20, "knob": 14, "onTrack": "signal", "offTrack": "line.strong", "onKnob": "#FFFFFF", "offKnob": "text.muted" },
  "fader": {
    "taper": [[6, 0], [0, 0.14], [-6, 0.28], [-12, 0.42], [-24, 0.6], [-36, 0.74], [-48, 0.86], [-60, 0.94], [null, 1]],
    "taperNote": "fraction of travel from the top; null = -inf; linear between marks; -60..-90 dB compresses into the last 6%",
    "scaleLabels": [6, 0, -6, -12, -24, -36, -48, null],
    "inset": 10,
    "track": { "width": 4, "radius": 2, "color": "line" },
    "fill": { "color": "signal", "mutedColor": "ink.ghost" },
    "cap": { "width": 32, "height": 16, "radius": 3, "fill": "#2E333A", "rim": "ink.arrow", "centerLine": "text", "centerLineWidth": 2 },
    "capCompact": { "width": 28, "height": 14 },
    "capHorizontal": { "width": 12, "height": 18 },
    "variants": { "channel": { "width": 116 }, "compact": { "width": 40 }, "horizontal": { "height": 24 } },
    "meter": { "barWidth": 10, "barWidthMain": 14, "gap": 3, "well": "surface.inset", "wellLine": "line.inset", "peak": "meter.ok", "peakAlpha": 0.35, "rms": "meter.ok", "hold": "text", "holdHeight": 2, "clip": "meter.hot", "clipCell": 4 }
  },
  "toggle": {
    "height": 24,
    "radius": 4,
    "font": { "font": "sans", "weight": 600, "size": 11 },
    "off": { "fill": "surface.raised", "text": "text.muted", "border": "line" },
    "on": {
      "mute": { "fill": "text", "text": "bg.window", "border": "text" },
      "solo": { "fill": "signal", "text": "surface.inset", "border": "signal" },
      "arm": { "fill": "meter.hot", "text": "bg.window", "border": "meter.hot" },
      "monitor": { "fill": "#1E2A38", "text": "signal", "border": "signal" },
      "option": { "fill": "#1E2A38", "text": "signal", "border": "signal" }
    },
    "unavailable": { "fill": "#1E2125", "text": "ink.arrow", "border": "line" }
  },
  "pad": {
    "sizes": { "grid": 56, "focus": 80 },
    "gap": 4,
    "radius": 6,
    "fill": "surface.raised",
    "border": "line",
    "order": "bottom-left is pad 1 (MPC order)",
    "hit": { "color": "signal", "alpha": 0.26, "edge": 2, "heightFrom": "velocity", "decayMs": 250 },
    "selected": { "border": "signal", "width": 2 },
    "muted": { "opacity": 0.4 },
    "tag": { "height": 3 },
    "empty": { "border": "line.strong", "style": "dashed", "fill": "transparent", "label": "+ Drop" }
  },
  "meter": {
    "ballistics": {
      "peak_falloff": { "attack_ms": 0, "release_ms": 300 },
      "vu": { "attack_ms": 300, "release_ms": 300, "reference_dbfs": -18 }
    }
  },
  "channelStrip": {
    "width": 132,
    "widthMain": 160,
    "gap": 4,
    "colorBar": 3,
    "insertsHeight": 112,
    "sendsHeight": 86,
    "panKnob": 36,
    "selectedBorder": "signal",
    "insertSlot": {
      "height": 22, "fill": "surface.raised", "border": "line", "radius": 4,
      "indicator": "power", "indicatorSize": 12, "indicatorStroke": 1.5,
      "on": { "glyph": "signal", "name": "text" },
      "bypassed": { "glyph": "text.faint", "name": "text.muted" }
    }
  },
  "hatch": {
    "note": "a region that cannot take input right now: inactive tracks, suspended or missing plug-ins, frozen lanes, unavailable insert slots, beyond a clip's end in an editor; never a disabled-but-editable section (dim 40%), a muted track, a single small control, or anything under minSize",
    "color": "text",
    "alpha": 0.07,
    "alphaLight": 0.06,
    "stroke": 1.5,
    "angle": -45,
    "pitch": 8,
    "minSize": 48,
    "anchor": "window",
    "ghostClip": { "border": "ink.ghost", "fillAlpha": 0.18 }
  },
  "chrome": {
    "note": "egui's own widgets outside device panels (menus, popups, dialogs, tool windows, buttons, fields, checks, scroll bars, tooltips): the maintainer's application chrome document, draft 1",
    "type": {
      "button": { "font": "sans", "weight": 500, "size": 12, "color": "text" },
      "defaultButton": { "font": "sans", "weight": 600, "size": 12 },
      "question": { "font": "sans", "weight": 600, "size": 13, "color": "text" },
      "detail": { "font": "sans", "weight": 400, "size": 12, "color": "text.muted" },
      "title": { "font": "sans", "weight": 500, "size": 14, "color": "text" },
      "row": { "font": "sans", "weight": 400, "size": 12, "color": "text" },
      "shortcut": { "font": "mono", "weight": 400, "size": 11, "color": "text.faint" },
      "number": { "font": "mono", "weight": 500, "size": 11, "color": "text" }
    },
    "radius": { "window": 8, "popup": 5, "control": 5, "row": 4, "checkbox": 3 },
    "height": { "control": 26, "menuBar": 32, "menuBarItem": 22, "row": 24, "titleBar": 26, "deviceTitleBar": 52 },
    "button": { "padding": [0, 12], "defaultPadding": [0, 16], "icon": 26, "glyph": 14, "fill": "surface.raised", "hover": "button.hover", "pressed": "surface.selected", "border": null },
    "defaultButton": { "fill": "signal", "ink": "surface.inset", "hover": "#66ACFF", "pressed": "#3E85D8", "disabledFill": "toggle.unavailable.fill", "disabledInk": "ink.arrow" },
    "menuBarItem": { "padding": [0, 8] },
    "popup": { "fill": "surface.raised", "border": "line.strong", "padding": 4, "submenuOverlap": 4, "checkGutter": 16, "checkGlyph": 12, "chevron": 12, "separatorGap": 4 },
    "modal": { "width": 380, "padding": [18, 18, 16], "fill": "surface.panel", "border": "line.strong", "scrim": "overlay", "footerGap": 14 },
    "toolWindow": { "fill": "surface.panel", "border": "line.strong", "bodyPadding": [14, 16], "footerPadding": [10, 16], "closeHit": 18, "titleFill": "bg.titlebar", "titleLine": "line" },
    "field": { "fill": "surface.inset", "border": "line", "hoverBorder": "line.strong", "focus": "signal", "error": "meter.hot" },
    "checkbox": { "box": 14, "hit": 18, "mark": 8, "radioDot": 6, "off": { "fill": "surface.inset", "border": "line.strong" }, "on": { "fill": "signal", "mark": "surface.inset" } },
    "scrollBar": { "rest": 4, "hover": 8, "inset": 2, "minHandle": 24, "restColor": "ink.ghost", "hoverColor": "ink.arrow", "dragColor": "text.faint", "track": "surface.panel" },
    "tooltip": { "delayMs": 500, "padding": [5, 8], "offset": 4 },
    "focusRing": { "width": 1.5, "offset": 2, "color": "focus.ring" },
    "selectionAlpha": { "dark": 0.6, "light": 0.35 }
  }
}
